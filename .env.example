# Copy to ".env" and fill in your own values. Never commit the real .env.

# ---- Sarvam AI (OPTIONAL) -------------------------------------------------
# Leave blank to run the whole app offline with the deterministic engine,
# templates and the built-in assistant.
SARVAM_API_KEY=

# Verified against the current Sarvam docs at build time:
#   chat      POST {SARVAM_BASE_URL}/v1/chat/completions   model: sarvam-105b
#   translate POST {SARVAM_BASE_URL}/translate             model: mayura:v1
# (sarvam-m is deprecated and rejected by the API.)
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai

# ---- Reproducibility (optional) -------------------------------------------
# Freeze "today" so demo deadlines and tests are stable. ISO date.
# OPPORTUNITYAI_TODAY=2026-10-25

# Where the local SQLite tracker is stored.
# OPPORTUNITYAI_DB=opportunityai.db

# Optional GitHub token for scripts/ingest_github.py (raises the rate limit).
# GITHUB_TOKEN=
